[Unit]
Description=MonoOps
After=network-online.target monoops-docker-proxy.socket
Wants=network-online.target monoops-docker-proxy.socket

[Service]
Type=simple
User=monoops
Group=monoops
# Reads the whole system journal (module J), read-only.
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/monoops
ExecStart=/usr/local/bin/monoops
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
StateDirectory=monoops
# Package inventory for monoops-vulnscan.service (module V); ignored when
# the directory does not exist.
ReadWritePaths=-/var/lib/monoops-vulnscan/inventory
# Backup jobs for monoops-backup@.service (phase 6); ignored when the
# directory does not exist.
ReadWritePaths=-/var/lib/monoops-backup/jobs
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=-/etc/monoops/manager.env
# Master key of the secrets box (TOTP), encrypted with systemd-creds in
# /etc/credstore.encrypted/ (see README). A missing credential does not
# prevent the start: TOTP is then unavailable, recovery codes still work.
ImportCredential=monoops-secrets-key

[Install]
WantedBy=multi-user.target
