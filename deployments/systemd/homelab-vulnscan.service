# Homelab Manager: runs Grype on the package inventory written by the
# Manager (SPEC_ADMINISTRATION.md § 8 ter.2). Started only by the Manager
# over D-Bus, allowed by deployments/polkit/50-homelab-manager-vulnscan.rules;
# never enabled. The commands are fixed: nothing from the Manager or a user
# is added to them.
#
# To stop the daily download of the Grype database (D-10), run
# "systemctl edit homelab-vulnscan.service" and add:
#   [Service]
#   Environment=GRYPE_DB_AUTO_UPDATE=false
# then import a database by hand (grype db import, see README).
[Unit]
Description=Homelab Manager vulnerability scan (Grype)
Documentation=https://github.com/anchore/grype
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=homelab-vulnscan
Group=homelab-vulnscan
Environment=HOME=/var/cache/homelab-vulnscan
Environment=XDG_CACHE_HOME=/var/cache/homelab-vulnscan
Environment=GRYPE_DB_CACHE_DIR=/var/cache/homelab-vulnscan/db
Environment=GRYPE_DB_AUTO_UPDATE=true
Environment=GRYPE_DB_VALIDATE_AGE=true
# A database older than 5 days fails the scan instead of giving a
# misleading result.
Environment=GRYPE_DB_MAX_ALLOWED_BUILT_AGE=120h
Environment=GRYPE_CHECK_FOR_APP_UPDATE=false
# A result left by an earlier run must never be read as the new one.
ExecStartPre=/usr/bin/rm -f /var/lib/homelab-vulnscan/result/result.json
ExecStart=/usr/bin/grype sbom:/var/lib/homelab-vulnscan/inventory/inventory.json -o json --file /var/lib/homelab-vulnscan/result/result.json
TimeoutStartSec=15min
UMask=0027
CacheDirectory=homelab-vulnscan
CacheDirectoryMode=0750
ReadWritePaths=/var/lib/homelab-vulnscan/result
# Lowest priority and bounded resources: the scan never competes with the
# services of the machine.
CPUWeight=idle
IOSchedulingClass=idle
Nice=19
MemoryMax=1G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# Network only to download the Grype database (HTTPS), no listening socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
