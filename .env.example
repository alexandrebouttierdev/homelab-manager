# Manager
MONOOPS_HTTP_ADDRESS=:8080
MONOOPS_DATABASE_PATH=./data/monoops.db
MONOOPS_ADMIN_USERNAME=admin
# Empty: first start creates admin/admin, whose change is forced at the first login. Otherwise 12+ characters.
MONOOPS_ADMIN_PASSWORD=
MONOOPS_SESSION_SECURE=false
MONOOPS_TLS_CERT_FILE=
MONOOPS_TLS_KEY_FILE=

# Local collection settings
MONOOPS_SYSTEM_COLLECT_INTERVAL_SECONDS=10
MONOOPS_DOCKER_COLLECT_INTERVAL_SECONDS=15
MONOOPS_DOCKER_DISCOVERY_INTERVAL_SECONDS=30
MONOOPS_DOCKER_PROXY_SOCKET=/run/monoops-docker-proxy/docker.sock
MONOOPS_METRICS_RETENTION_DAYS=7
MONOOPS_DOCKER_ENGINE_SOCKET=/var/run/docker.sock
# Relative paths are resolved from backend/ (scripts/dev.sh runs go -C backend).
MONOOPS_WEB_ROOT=../frontend/dist

# Master key of the secrets box (32 bytes in base64). scripts/dev.sh creates
# ./data/secrets.key; empty: TOTP unavailable, recovery codes still work.
MONOOPS_SECRETS_KEY_FILE=

# Passkeys and FIDO2 keys: a domain name (not an IP) and the exact origins,
# separated by spaces. WebAuthn works over plain HTTP on localhost only.
MONOOPS_WEBAUTHN_RP_ID=
MONOOPS_WEBAUTHN_ORIGINS=
