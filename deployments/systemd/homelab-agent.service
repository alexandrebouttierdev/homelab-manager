[Unit]
Description=Homelab Manager Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homelab-agent
Group=homelab-agent
ExecStart=/usr/local/bin/homelab-agent
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
EnvironmentFile=-/etc/homelab-manager/agent.env

[Install]
WantedBy=multi-user.target
