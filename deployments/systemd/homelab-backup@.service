# Homelab Manager: runs one restic operation for the Manager
# (SPEC_ADMINISTRATION.md § 7.1): init, backup, forget-prune, check,
# restore (into /var/lib/homelab-backup/restore/<run>), snapshots, unlock,
# diff, copy (to the copy repository). Started
# only by the Manager over D-Bus, allowed by
# deployments/polkit/50-homelab-manager-backup.rules; never enabled.
# homelab-backup-runner reads the job the Manager wrote in
# /var/lib/homelab-backup/jobs, validates it again and runs restic without a
# shell; the result goes to /var/lib/homelab-backup/runs.
#
# An SFTP repository needs the ssh client (openssh-client): restic starts
# it with the key of the Manager and the pinned host keys, written by the
# runner in its private /tmp and removed at the end (decision D-13); the
# configuration and the keys of root are never used.
#
# It runs as root to read every source an administrator chose. It can write
# only its cache, its results and the usual mount points of a backup disk
# or share (/mnt, /media, /srv, /var/backups). For a local repository
# elsewhere, run "systemctl edit homelab-backup@.service" and add:
#   [Service]
#   ReadWritePaths=/path/of/the/repository
[Unit]
Description=Homelab Manager backup operation %i (restic)
Documentation=https://restic.readthedocs.io/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/homelab-backup-runner %i
TimeoutStartSec=6h
UMask=0027
CacheDirectory=homelab-backup
CacheDirectoryMode=0700
ReadWritePaths=/var/lib/homelab-backup/runs /var/lib/homelab-backup/jobs /var/lib/homelab-backup/restore
ReadWritePaths=-/mnt -/media -/srv -/var/backups
# Low priority: a backup never competes with the services of the machine.
CPUWeight=idle
IOSchedulingClass=idle
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# Network for the remote repositories (rest-server, S3, SFTP), no listening socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Read every file, write the repository, remove the one-use secrets file,
# and restore owners, modes and times in the quarantine: nothing else.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
