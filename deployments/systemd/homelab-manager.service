[Unit]
Description=Homelab Manager
After=network-online.target postgresql.service homelab-docker-proxy.socket
Wants=network-online.target homelab-docker-proxy.socket

[Service]
Type=simple
User=homelab-manager
Group=homelab-manager
WorkingDirectory=/opt/homelab-manager
ExecStart=/usr/local/bin/homelab-manager
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
EnvironmentFile=-/etc/homelab-manager/manager.env

[Install]
WantedBy=multi-user.target
