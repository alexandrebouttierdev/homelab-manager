// Homelab Manager: lets the homelab-manager account start the backup
// operations of homelab-backup@.service, and nothing else
// (SPEC_ADMINISTRATION.md § 2.1 and § 7.1): only the listed instances, only
// the verb start; no stop, restart, enable nor daemon-reload.
//
// Install as root:root 0644 in /etc/polkit-1/rules.d/.
polkit.addRule(function (action, subject) {
    var units = [
        "homelab-backup@init.service", "homelab-backup@backup.service",
        "homelab-backup@forget-prune.service", "homelab-backup@check.service",
        "homelab-backup@restore.service", "homelab-backup@snapshots.service",
        "homelab-backup@unlock.service", "homelab-backup@diff.service",
        "homelab-backup@copy.service"
    ];
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.user === "homelab-manager" &&
        units.indexOf(action.lookup("unit")) >= 0 &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
