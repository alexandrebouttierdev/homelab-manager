# Manager
HOMELAB_HTTP_ADDRESS=:8080
HOMELAB_DATABASE_PATH=./data/homelab-manager.db
HOMELAB_ADMIN_USERNAME=admin
# Empty: first start creates admin/admin, whose change is forced at the first login. Otherwise 12+ characters.
HOMELAB_ADMIN_PASSWORD=
HOMELAB_SESSION_SECURE=false
HOMELAB_TLS_CERT_FILE=
HOMELAB_TLS_KEY_FILE=

# Local collection settings
HOMELAB_SYSTEM_COLLECT_INTERVAL_SECONDS=10
HOMELAB_DOCKER_COLLECT_INTERVAL_SECONDS=15
HOMELAB_DOCKER_DISCOVERY_INTERVAL_SECONDS=30
HOMELAB_DOCKER_PROXY_SOCKET=/run/homelab-docker-proxy/docker.sock
HOMELAB_METRICS_RETENTION_DAYS=7
HOMELAB_DOCKER_ENGINE_SOCKET=/var/run/docker.sock
# Relative paths are resolved from backend/ (scripts/dev.sh runs go -C backend).
HOMELAB_WEB_ROOT=../frontend/dist

# Master key of the secrets box (32 bytes in base64). scripts/dev.sh creates
# ./data/secrets.key; empty: TOTP unavailable, recovery codes still work.
HOMELAB_SECRETS_KEY_FILE=

# Passkeys and FIDO2 keys: a domain name (not an IP) and the exact origins,
# separated by spaces. WebAuthn works over plain HTTP on localhost only.
HOMELAB_WEBAUTHN_RP_ID=
HOMELAB_WEBAUTHN_ORIGINS=
